{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Unit",
	"description": "Almanac's starter schema: the shape every unit needs. Replace or extend it to suit your school.",
	"type": "object",
	"required": ["unit_title", "subject", "description", "syllabus_registry", "lessons"],
	"properties": {
		"unit_title": { "type": "string", "minLength": 1 },
		"subject": { "type": "string", "minLength": 1 },
		"description": { "type": "string" },
		"syllabus_registry": {
			"description": "The syllabus points the unit's lessons link to, by id.",
			"type": "array",
			"items": {
				"type": "object",
				"required": ["id", "framework", "phase", "text"],
				"properties": {
					"id": { "type": "string", "minLength": 1 },
					"framework": { "type": "string", "minLength": 1 },
					"phase": { "type": "string", "minLength": 1 },
					"text": { "type": "string", "minLength": 1 }
				}
			}
		},
		"lessons": {
			"description": "The unit's lesson plans, as paths relative to the unit, in teaching order.",
			"type": "array",
			"items": { "type": "string", "pattern": "[.]json$" },
			"uniqueItems": true
		}
	}
}
